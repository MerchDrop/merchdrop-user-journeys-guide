# Supabase — get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
VITE_SUPABASE_URL=https://<your-project-id>.supabase.co
VITE_SUPABASE_PROJECT_ID=<your-project-id>
VITE_SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>

# Paystack — get from: https://dashboard.paystack.com/#/settings/developers
VITE_PAYSTACK_PUBLIC_KEY=pk_test_<your-paystack-public-key>

# Sentry — get from: https://sentry.io/settings/<your-org>/projects/<your-project>/keys/
VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project-id>
